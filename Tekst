let
    Baza = "https://moam.knf.gov.pl/moam.nsf/mOAM?readForm&RestrictToCategory=",
    DniWstecz = 7,
    NaStronie = 20,
    MaxStron = 10,

    // Wzorce wpadają zawsze, gdy tytuł (bez spacji, kropek, myślników, małymi literami) je zawiera
    Slowa = {"stanuposiadania", "zawiadomienieakcjonariusz", "zmianiecelu",
             "progu", "progów", "zmianaudziału", "zmianieudziału", "zmianąudziału"},

    // Tytuły odrzucane (np. listy akcjonariuszy na WZA), z wyjątkiem tytułów z art. 69/70
    Wykluczenia = {"listaakcjonariusz", "listęakcjonariusz", "akcjonariuszyposiadając",
                   "nwza", "zwza", "walnezgromadzenie", "walnegozgromadzenia", "uchwał"},

    Kolumny = {"Emitent", "Data wpływu", "Tytuł raportu"},
    Pusta = #table(Kolumny, {}),

    fnTxt = (x as any) as text =>
        if x is table then
            Text.Trim(Text.Combine(List.Transform(Table.ToRows(x), each Text.Combine(List.Transform(_, each @fnTxt(_)), " ")), " "))
        else if x = null then ""
        else Text.From(x),

    fnStrona = (d as date, s as number) as table =>
        let
            Dzien = Date.ToText(d, "yyyy-MM-dd"),
            Url = Baza & Dzien & "&start=" & Text.From(s) & "&count=" & Text.From(NaStronie),
            Src = Web.Page(Web.Contents(Url)),
            Tabele = List.Select(Src[Data], each Table.ColumnCount(_) >= 3 and Table.RowCount(_) > 0),
            Najw = List.Max(Tabele, null, each Table.RowCount(_)),
            Nazwy = List.FirstN(Table.ColumnNames(Najw), 3),
            Trzy = Table.SelectColumns(Najw, Nazwy),
            Nazwane = Table.RenameColumns(Trzy, List.Zip({Nazwy, Kolumny})),
            Tekst = Table.TransformColumns(Nazwane,
                {{"Emitent", each fnTxt(_), type text},
                 {"Data wpływu", each fnTxt(_), type text},
                 {"Tytuł raportu", each fnTxt(_), type text}}),
            Czyste = Table.SelectRows(Tekst, each [Data wpływu] = Dzien and [Tytuł raportu] <> "")
        in
            Czyste,

    fnStronaBezpiecznie = (d as date, s as number) as table =>
        try fnStrona(d, s) otherwise Pusta,

    fnDzien = (d as date) as table =>
        let
            Strony = List.Generate(
                () => [s = 1, t = fnStronaBezpiecznie(d, 1)],
                each Table.RowCount([t]) > 0,
                each [
                    s = [s] + NaStronie,
                    t = if Table.RowCount([t]) < NaStronie or [s] / NaStronie >= MaxStron
                        then Pusta
                        else fnStronaBezpiecznie(d, [s] + NaStronie)
                ],
                each [t])
        in
            if List.IsEmpty(Strony) then Pusta else Table.Combine(Strony),

    Dni = List.Transform({0..DniWstecz-1}, each Date.AddDays(Date.From(DateTime.LocalNow()), -_)),
    Wszystko = Table.Combine(List.Transform(Dni, fnDzien)),

    Norm = Table.AddColumn(Wszystko, "tmp", each
        Text.Remove(Text.Lower([Tytuł raportu]), {" ", ".", "#(00A0)", "-", "_"}), type text),

    CzyZmiana = (t as text) as logical =>
        Text.Contains(t, "przekroczeni") or Text.Contains(t, "osiągnięci")
        or Text.Contains(t, "zmniejszeni") or Text.Contains(t, "zmianaudziału")
        or Text.Contains(t, "zmianieudziału") or Text.Contains(t, "zmianąudziału")
        or Text.Contains(t, "zmianiestanu") or Text.Contains(t, "zmianastanu"),

    Filtr = Table.SelectRows(Norm, each
        let t = [tmp] in
        Text.Contains(t, "art69") or Text.Contains(t, "art70")
        or Text.Contains(t, "artykuł69") or Text.Contains(t, "artykułu69")
        or Text.Contains(t, "artykuł70") or Text.Contains(t, "artykułu70")
        or (not List.AnyTrue(List.Transform(Wykluczenia, (w) => Text.Contains(t, w)))
            and (List.AnyTrue(List.Transform(Slowa, (s) => Text.Contains(t, s)))
                 or (CzyZmiana(t) and (Text.Contains(t, "głos") or Text.Contains(t, "akcj")
                                       or Text.Contains(t, "udział") or Text.Contains(t, "%")))))),

    Wynik = Table.Sort(Table.RemoveColumns(Filtr, {"tmp"}), {{"Data wpływu", Order.Descending}})
in
    Wynik
